+
+    /// Shorten only the rendered value; the payload and accessibility label stay intact.
+    static func readableLine(_ source: String, width: CGFloat, pointSize: CGFloat) -> String {
+        let font = UIFont.systemFont(ofSize: pointSize, weight: .semibold)
+        func fits(_ value: String) -> Bool {
+            (value as NSString).size(withAttributes: [.font: font]).width <= max(0, width - 1)
+        }
+        guard !fits(source) else { return source }
+        let characters = Array(source)
+        var low = 0
+        var high = characters.count
+        while low < high {
+            let mid = (low + high + 1) / 2
+            if fits(String(characters.prefix(mid)) + "…") { low = mid } else { high = mid - 1 }
+        }
+        let prefix = String(characters.prefix(low))
+        var boundary: String.Index?
+        source.enumerateSubstrings(in: source.startIndex..<source.endIndex, options: .byWords) { _, range, _, stop in
+            if range.upperBound <= source.index(source.startIndex, offsetBy: low) {
+                boundary = range.upperBound
+            } else { stop = true }
+        }
+        // A single word can exceed the entire region. Preserve grapheme clusters
+        // rather than dropping all useful content in that case.
+        let visible = boundary.map { String(source[..<$0]) } ?? prefix
+        return visible + "…"
+    }
+
 }
 
