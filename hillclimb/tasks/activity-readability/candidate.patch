@@ -83,6 +83,34 @@ enum ReminderActivityLayout {
         max(1, Int((availableHeight(surface) + LockScreenLineBudget.lineSpacing)
             / (rowHeight(pointSize: pointSize) + LockScreenLineBudget.lineSpacing)))
