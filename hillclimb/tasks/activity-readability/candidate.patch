diff --git a/ios/Tests/ActivityReadabilityTests.swift b/ios/Tests/ActivityReadabilityTests.swift
new file mode 100644
index 0000000..888ba9a
--- /dev/null
+++ b/ios/Tests/ActivityReadabilityTests.swift
@@ -0,0 +1,46 @@
+import XCTest
+import UIKit
+@testable import LazyMansReminders
+
+final class ActivityReadabilityTests: XCTestCase {
+    func testRenderedPrefixEndsAtCompleteWord() {
+        let source = "Demo 2: Review the sample notes for tomorrow"
+        let result = ReminderActivityLayout.readableLine(source, width: 320, pointSize: 23)
+        XCTAssertEqual(result, "Demo 2: Review the sample…")
+        XCTAssertTrue(source.hasPrefix(String(result.dropLast())))
+    }
+
+    func testFittingTextAndSummaryLikeUserTextRemainVerbatim() {
+        for source in ["+8 more", "Nothing to remember", "Buy milk", "", "مرحبا", "日本語", "👩🏽‍💻 café"] {
+            XCTAssertEqual(ReminderActivityLayout.readableLine(source, width: 1000, pointSize: 15), source)
+        }
+    }
+
+    func testLongWordAndUnicodePreserveGraphemesAndWidth() {
+        for source in [String(repeating: "W", count: 200), String(repeating: "👩🏽‍💻", count: 80),
+                       String(repeating: "日本語の買い物", count: 40), String(repeating: "مرحبا بالعالم ", count: 40),
+                       String(repeating: "e\u{301}", count: 200)] {
+            for width: CGFloat in [80, 200, 340] {
+                let result = ReminderActivityLayout.readableLine(source, width: width, pointSize: 23)
+                XCTAssertTrue(result.hasSuffix("…"))
+                XCTAssertTrue(source.hasPrefix(String(result.dropLast())))
+                XCTAssertLessThanOrEqual((result as NSString).size(withAttributes: [.font: UIFont.systemFont(ofSize: 23, weight: .semibold)]).width, width)
+            }
+        }
+    }
+
+    func testByteAndSurfaceCapsConserveEveryOriginalWithoutParsingCopy() throws {
+        let originals = ["+8 more"] + (1...99).map { "\($0) " + String(repeating: "👩🏽‍💻 café ", count: 100) }
+        let reminder = Reminder(id: UUID(), userID: UUID(), text: originals.joined(separator: "\n"), sortOrder: 0, isDone: false, createdAt: .now)
+        let state = ReminderActivityPresentation.state(from: [reminder], limit: 16)
+        XCTAssertLessThanOrEqual(try JSONEncoder().encode(state).count + JSONEncoder().encode(ReminderAttributes()).count, 4096)
+        for limit in 1...16 {
+            let capped = ReminderActivityPresentation.cappedState(state, limit: limit)
+            XCTAssertEqual(capped.lines.count - 1 + (capped.hiddenLineCount ?? 0), 100)
+            XCTAssertEqual(capped.lines.last, "+\(capped.hiddenLineCount!) more")
+        }
+        let legacy = try JSONDecoder().decode(ReminderAttributes.ContentState.self, from: Data(#"{"lines":["+8 more","Actual reminder"]}"#.utf8))
+        XCTAssertNil(legacy.hiddenLineCount)
+        XCTAssertEqual(ReminderActivityPresentation.surfaceLines(legacy, limit: 3), legacy.lines)
+    }
+}
