{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lazy-mans-reminders-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  },
  "vars": {
    "WEB_ORIGINS": "https://lmr.sillyapps.co,https://lmr.edmundlim.systems,https://lazy-mans-reminders.pages.dev"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "lmr-mcp.edmundlim.systems",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "da71061d020b45ccaf4249050eec6edd"
    }
  ]
}
